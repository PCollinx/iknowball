# Copy to .env.local for local dev. In Vercel, set these under Project > Settings > Environment Variables.
# NEXT_PUBLIC_* values are sent to the browser; everything else stays on the server.

# Public base URL. The only place the domain lives, so moving to iknowball.com is one change.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security: never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Highlightly football API (server only; used by scheduled jobs, never by players)
HIGHLIGHTLY_API_KEY=
HIGHLIGHTLY_BASE_URL=https://soccer.highlightly.net
HIGHLIGHTLY_PL_LEAGUE_ID=33973
HIGHLIGHTLY_SEASON=2026

# Shared secret that scheduled jobs send to /api/jobs/* routes
CRON_SECRET=

# PostHog (Project settings > Project API key). EU host shown; use https://us.i.posthog.com for a US project.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Sentry (Project settings > Client keys). Auth token only needed in Vercel for source-map upload.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Beta invite (server only, 8+ characters). While the waitlist is up on the live
# site (1 to 20 Nov 2026), /beta/{this code} lets a browser through to the games.
# Change it to shut out every old invite.
BETA_CODE=
